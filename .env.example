# Copy to .env.local for local development. All three are optional locally.

# Neon Postgres connection string. Leave unset to use the file-backed PGlite
# database under .data/ (zero external services).
# DATABASE_URL=postgres://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Passcode the couple types at /admin. Defaults to "shanai-rhea" when unset (dev only).
ADMIN_PASSCODE=

# Random secret used to sign the admin cookie. Defaults to a hash of the passcode.
ADMIN_SECRET=
